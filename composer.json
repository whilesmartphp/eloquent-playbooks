{
    "name": "whilesmart/eloquent-playbooks",
    "description": "Polymorphic sales playbooks (ICP, personas, offer, positioning, competitors, objections) for Laravel, with optional AI extraction from web pages.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        { "name": "Whilesmart Team" }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "whilesmart/eloquent-owner-access": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "laravel/pint": "^1.22",
        "fakerphp/faker": "^1.24",
        "whilesmart/eloquent-agents": "^1.1"
    },
    "suggest": {
        "whilesmart/eloquent-agents": "Drafts playbook entries from web pages with the playbook.save tool and the playbook-extractor harness."
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "autoload": {
        "psr-4": {
            "Whilesmart\\Playbooks\\": "src/",
            "Whilesmart\\Playbooks\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Whilesmart\\Playbooks\\PlaybooksServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/testbench package:test",
        "pint": ["./vendor/bin/pint"],
        "pint:test": ["./vendor/bin/pint --test"]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
